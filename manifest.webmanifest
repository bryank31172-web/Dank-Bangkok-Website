{
  "id": "/",
  "name": "DANK BKK",
  "short_name": "DANK",
  "description": "DANK BKK premium cannabis menu, cart, checkout and order tracking.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#060a07",
