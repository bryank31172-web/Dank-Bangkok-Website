  "icons": [
    {"src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable"},
    {"src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any"}
  ],
  "shortcuts": [
    {"name": "Shop menu", "short_name": "Shop", "url": "/?source=pwa-shortcut", "icons": [{"src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml"}]},
    {"name": "Checkout", "short_name": "Checkout", "url": "/checkout", "icons": [{"src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml"}]}
  ],
  "prefer_related_applications": false
}
