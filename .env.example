# Several of the values below are marked REQUIRED. They used to have working
# fallbacks compiled into the api/ files — a default staff key, a default admin
# password, a default POS link key — so the site ran with zero setup. It also
# meant every copy of the source was a copy of the credentials. The fallbacks
# are gone. An endpoint whose key is unset now answers 503 "not configured"
# instead of accepting a guessable one, so a blank variable shows up as a
# broken feature you can see rather than an open door you can't.
STOREHUB_STORE=your-store-subdomain
STOREHUB_TOKEN=your-storehub-api-token
STAFF_KEY=
# ^ REQUIRED — staff console, POS link and every staff-only endpoint; pick a long random string
# AI budtender — set ONE of these. The first one found wins, free tiers first.
# Gemini (aistudio.google.com) and Groq (console.groq.com) both have free tiers.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# AI_PROVIDER=gemini   # optional, forces one when several keys are set
# AI_MODEL=            # optional, overrides that provider's default model
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
# Shopify — push each website order into the dankbkk.com admin as an unpaid
# order. Leave blank and nothing is sent. SHOPIFY_STORE is the myshopify
# domain (dank-bkk.myshopify.com), NOT dankbkk.com. Token comes from a custom
# app with the write_orders scope and starts "shpat_".
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2025-07
# SHOPIFY_ORDER_TAGS=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ── WhatsApp Cloud API (staff order alerts) ──
WHATSAPP_ACCESS_TOKEN=
# ^ use a Meta system-user token for production; never put it in browser code
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# ^ one or more staff numbers in international digits, comma-separated (for example 66812345678)
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
# ^ recommended: approved Utility template with one body text variable for reliable alerts
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# ── LINE (staff alerts + LINE OA becomes น้องแดงค์) ──
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ^ REQUIRED if you use the LINE OA — it is what proves an incoming webhook is
#   really from LINE. Blank no longer means "skip the check"; it means every
#   webhook fails the signature test and only the ?k=STAFF_KEY path gets in.
LINE_TO=
# ^ LINE_TO = Bryan's userId OR a staff group id (the OA must be in that group)
# ── LINE group monitor / daily summary (Bryan AI, folded in) ──
MONITORED_GROUP_IDS=
# ^ optional comma-separated group ids to log; blank = log all groups the OA is in
SUMMARY_TO=
# ^ optional: where daily summaries go (defaults to LINE_TO)
CRON_SECRET=
# ^ set any secret so Vercel Cron can authorize the daily /api/line-summary run
# ── Delivery ETA (Google Routes) replied to customers on LINE ──
GOOGLE_MAPS_API_KEY=
# Branches you deliver from live in branches.json (all 4 DANK shops). The bot
# quotes the NEAREST branch automatically. Edit branches.json (best: put each
# origin as "lat,lng"), or override here with a JSON array:
# SHOP_BRANCHES=[{"id":"pattanakarn","name":"DANK Pattanakarn","origin":"13.70,100.65"}]
SHOP_ORIGIN=
# ^ optional single-origin fallback if you don't use branches.json
DELIVERY_MODE=TWO_WHEELER
# ^ TWO_WHEELER (motorbike, default) or DRIVE
DELIVERY_PREP_MIN=15
# ROUTE_API_URL=   # optional: your own route endpoint instead of calling Google
# ── Storage (needed for orders, wallet, staff chat AND owner edit-mode) ──
#    Supabase is what the shop runs on. Project Settings → API.
#    The SECOND one is the secret/service_role key, never the publishable
#    one — the publishable key cannot see site_kv at all and the site would
#    silently remember nothing. It is server-side only; never put it in a page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#    Upstash Redis is still accepted as an alternative, used only when the
#    two Supabase values above are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ── Owner edit-mode login (/api/admin). The email, a password hash and a
#    token-signing secret were all written into api/admin.js, so anybody with
#    the source could log in as the owner and sign their own session tokens.
#    All three are now required and the file carries no defaults. Leave them
#    blank and owner login returns 503; the public parts of /api/admin (the
#    saved page overrides customers read) keep working either way. ──
ADMIN_EMAIL=
# ^ REQUIRED for owner login — the address you sign in with
ADMIN_PASSWORD=
# ^ REQUIRED for owner login — plaintext here, hashed before it is compared, never stored
ADMIN_SECRET=
# ^ REQUIRED for owner login — signs the session token; change it to log every device out
# ^ ALSO signs every member's QR card code, so there is no second secret to set
# ── Master PIN for promotions only (optional) ──────────────────────────────
#    A short code you can give whoever is running this week's promotion. It
#    opens the promotions editor on the website and NOTHING else — no product,
#    no price, no stock — because the token it issues is scoped and the server
#    refuses to apply anything but promos with it. Set it here, never in the
#    page source: a six-digit number sitting in a file the public can download
#    is not a lock. Leave it blank and the PIN door answers 503, which is what
#    you want if nobody needs it. Sessions last 12 hours. Wrong tries are rate
#    limited to 8 per 15 minutes per address.
MASTER_PIN=
# ^ Digits only. Change it and every PIN session in the field stops working.

# ── Member cards (optional) ────────────────────────────────────────────────
MEMBER_QR_SECRET=
# ^ Leave BLANK. Member card codes are signed with ADMIN_SECRET by default.
#   Only fill this in if you ever need to invalidate every card that has been
#   printed or saved — changing it re-issues every code at once, and the old
#   ones stop resolving in the staff console.
# ── Shared secret for the push webhooks (/api/gbp-webhook, /api/storehub-webhook) ──
WEBHOOK_SECRET=
# ^ REQUIRED if anything posts to those two — sent as ?secret= or header
#   x-webhook-secret. It used to be skipped when blank, which let a stranger
#   mark orders paid. Blank now means both webhooks answer 503.
# ── Live catalog from your BRYAN POS app (dank-medical-pos-app) ──
# The POS PUSHES its menu to this website (POST /api/pos-feed) every ~45s;
# the site serves it as the freshest source. The two used to share a link key
# written into both codebases, which meant anyone with the source could replace
# the shop's whole menu and its prices. Pick your own: set POS_SYNC_KEY here AND
# paste the same value in POS Settings → Website connection.
POS_SYNC_KEY=
# ^ REQUIRED for the POS→website menu push; blank makes /api/pos-feed answer 503
POS_FEED_MAX_AGE_H=72
# ^ how long the site trusts the last POS push before falling back (hours)
POS_APP_URL=https://dank-medical-pos-app.vercel.app
# ^ legacy pull path: also probes the POS URL for a JSON list (harmless backup)
# POS_FEED_PATHS=/api/products,/api/menu,/api/catalog,/api/inventory
# ^ optional override of which POS paths to try (comma-separated)
CRM_WEBHOOK_URL=
# ^ optional: new website members are also POSTed here (wire to your POS/CRM)
BEAM_MERCHANT_ID=
BEAM_API_KEY=
# ^ Beam Checkout (beamcheckout.com) — PromptPay QR at 0%, cards from ~1.8%.
#   Dashboard → Developers → API keys. BEAM_API_KEY is server-side only and
#   must never appear in a page. Both are needed before Beam shows at checkout.
#   Webhook: https://www.dankbangkok.com/api/beam-webhook?secret=<WEBHOOK_SECRET>
#   WEBHOOK_SECRET above is what authenticates it — without that, a paid order
#   is never marked paid, and /api/health says so.
# BEAM_PARTNER_ID=
# ^ only for partner integrations; a shop on its own account leaves this unset
# BEAM_API_BASE=
# ^ optional: point at Beam's Playground host to test without moving real money
TWOC2P_MERCHANT_ID=
TWOC2P_SECRET=
TWOC2P_ENV=sandbox
GBP_SECRET_KEY=
GBP_PUBLIC_KEY=
